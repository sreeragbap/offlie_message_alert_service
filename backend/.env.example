# Copy to backend/.env and fill in. Never commit the real file.
# Supabase dashboard -> Connect -> "Session pooler" (IPv4) connection string, converted to JDBC:
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=
DB_POOL_SIZE=5
# Optional: run Flyway as the owner (postgres) while the app uses a least-privilege role.
# DB_MIGRATION_USERNAME=postgres.YOUR_PROJECT_REF
# DB_MIGRATION_PASSWORD=

# Supabase dashboard -> Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Optional, server-only. Lets "delete my account" also delete the Supabase Auth user.
SUPABASE_SERVICE_ROLE_KEY=

OMA_API_DOCS_ENABLED=true
OMA_SERVER_SMS_ENABLED=false

# WhatsApp Business Platform (see docs/04-whatsapp-setup.md). Server-only secrets.
# Meta app -> WhatsApp -> API Setup: "Phone number ID" and an access token (system-user token for long use).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta app -> App settings -> Basic -> App secret (verifies webhook signatures).
WHATSAPP_APP_SECRET=
# Any random string; enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Template for first messages (recipient hasn't messaged you in 24 h). hello_world takes no params.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Comma-separated values for {{1}}, {{2}}...: sender, name, text. Example: sender,text
WHATSAPP_TEMPLATE_PARAMS=
